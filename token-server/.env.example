# Copy to .env and fill in real values (from LiveKit Cloud > Project > Settings > Keys).
# .env is gitignored — never commit real secrets.

# WebSocket URL of your LiveKit Cloud project (subdomain: dalab-ai-rkv31z2w)
LIVEKIT_URL=wss://dalab-ai-rkv31z2w.livekit.cloud

# API key + secret pair from LiveKit Cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# The named agent to dispatch into each room (must match agent.py)
AGENT_NAME=web-agent

# Browser origins allowed to call this token server (comma-separated).
# Local dev defaults cover the static site (:8080) and Vite dev server (:5173).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Alternative to ALLOWED_ORIGINS: a single COMMA-FREE regex matching allowed
# origins. Preferred in Cloud Run, where comma-separated env values get split
# (dropping every origin after the first). Prod uses:
#   ALLOWED_ORIGIN_REGEX=https://(www\.)?dalabai\.com
# Leave unset for local dev (ALLOWED_ORIGINS above already covers localhost).
# ALLOWED_ORIGIN_REGEX=

# Token lifetime in seconds (only needs to outlast connection setup)
TOKEN_TTL_SECONDS=900

# Port the token server listens on locally
PORT=8000
